<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Omo Rabi Software Client Portal - Track your project progress, updates and milestones.">

    <title>Client Portal | Omo Rabi Software</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #172033;
            line-height: 1.6;
        }

        .topbar {
            background: #101828;
            color: white;
            padding: 16px 20px;
        }

        .topbar-content {
            max-width: 1100px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .brand {
            font-size: 20px;
            font-weight: 800;
        }

        .brand span {
            color: #38bdf8;
        }

        .portal-label {
            font-size: 13px;
            opacity: 0.8;
        }

        .container {
            width: 92%;
            max-width: 1100px;
            margin: 35px auto;
        }

        .welcome {
            background: white;
            padding: 30px;
            border-radius: 18px;
            margin-bottom: 25px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
        }

        .welcome h1 {
            font-size: 30px;
            margin-bottom: 8px;
        }

        .welcome p {
            color: #667085;
        }

        .project-card {
            background: white;
            padding: 28px;
            border-radius: 18px;
            margin-bottom: 25px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
        }

        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .project-header h2 {
            font-size: 22px;
        }

        .status {
            background: #e8f8ef;
            color: #087443;
            padding: 7px 13px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: bold;
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .progress-bar {
            width: 100%;
            height: 14px;
            background: #e6eaf0;
            border-radius: 20px;
            overflow: hidden;
        }

        .progress-fill {
            width: 75%;
            height: 100%;
            background: linear-gradient(90deg, #2563eb, #38bdf8);
            border-radius: 20px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
        }

        .card h3 {
            margin-bottom: 18px;
            font-size: 19px;
        }

        .milestone {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid #edf0f4;
        }

        .milestone:last-child {
            border-bottom: none;
        }

        .check {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f8ef;
            color: #087443;
            font-weight: bold;
            flex-shrink: 0;
        }

        .current {
            background: #eaf2ff;
            color: #2563eb;
        }

        .pending {
            background: #f1f3f5;
            color: #667085;
        }

        .update {
            border-left: 4px solid #2563eb;
            padding: 15px 18px;
            background: #f8faff;
            margin-bottom: 15px;
            border-radius: 8px;
        }

        .update strong {
            display: block;
            margin-bottom: 5px;
        }

        .update small {
            color: #667085;
        }

        .files button,
        .action-btn {
            width: 100%;
            padding: 13px;
            margin-top: 10px;
            border: none;
            border-radius: 10px;
            background: #101828;
            color: white;
            font-size: 15px;
            cursor: pointer;
        }

        .files button:hover,
        .action-btn:hover {
            opacity: 0.9;
        }

        .message-box textarea {
            width: 100%;
            min-height: 120px;
            padding: 14px;
            border: 1px solid #d0d5dd;
            border-radius: 10px;
            resize: vertical;
            font-family: inherit;
            font-size: 15px;
            outline: none;
        }

        .message-box textarea:focus {
            border-color: #2563eb;
        }

        .approval {
            background: #fff8e7;
            border: 1px solid #f4d58d;
            padding: 20px;
            border-radius: 14px;
            margin-top: 20px;
        }

        .approval button {
            margin-top: 15px;
            padding: 12px 20px;
            border: none;
            border-radius: 9px;
            background: #2563eb;
            color: white;
            cursor: pointer;
            font-weight: bold;
        }

        footer {
            text-align: center;
            padding: 30px 20px;
            color: #667085;
            font-size: 14px;
        }

        @media (max-width: 700px) {

            .topbar-content {
                flex-direction: column;
                align-items: flex-start;
            }

            .welcome h1 {
                font-size: 25px;
            }

            .project-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <header class="topbar">

        <div class="topbar-content">

            <div class="brand">
                Omo Rabi <span>Software</span>
            </div>

            <div class="portal-label">
                CLIENT PORTAL
            </div>

        </div>

    </header>


    <main class="container">

        <section class="welcome">

            <h1>
                Welcome, Client 👋
            </h1>

            <p>
                Track your project progress, updates,
                milestones and approvals from one place.
            </p>

        </section>


        <section class="project-card">

            <div class="project-header">

                <div>
                    <h2>
                        Business Website Project
                    </h2>

                    <p>
                        Project ID: ORS-2026-001
                    </p>
                </div>

                <span class="status">
                    ● In Development
                </span>

            </div>


            <div class="progress-info">

                <span>
                    Overall Progress
                </span>

                <span>
                    75%
                </span>

            </div>


            <div class="progress-bar">

                <div class="progress-fill"></div>

            </div>

        </section>


        <section class="grid">


            <div class="card">

                <h3>
                    📋 Project Milestones
                </h3>


                <div class="milestone">

                    <div class="check">
                        ✓
                    </div>

                    <span>
                        Project Requirements
                    </span>

                </div>


                <div class="milestone">

                    <div class="check">
                        ✓
                    </div>

                    <span>
                        Website Design
                    </span>

                </div>


                <div class="milestone">

                    <div class="check">
                        ✓
                    </div>

                    <span>
                        Homepage Development
                    </span>

                </div>


                <div class="milestone">

                    <div class="check">
                        ✓
                    </div>

                    <span>
                        Services Page
                    </span>

                </div>


                <div class="milestone">

                    <div class="check current">
                        →
                    </div>

                    <span>
                        Contact System
                    </span>

                </div>


                <div class="milestone">

                    <div class="check pending">
                        6
                    </div>

                    <span>
                        Testing
                    </span>

                </div>


                <div class="milestone">

                    <div class="check pending">
                        7
                    </div>

                    <span>
                        Final Launch
                    </span>

                </div>

            </div>


            <div class="card">

                <h3>
                    📝 Latest Updates
                </h3>


                <div class="update">

                    <strong>
                        Contact System
                    </strong>

                    <p>
                        The contact section is currently
                        being developed and tested.
                    </p>

                    <small>
                        August 21, 2026
                    </small>

                </div>


                <div class="update">

                    <strong>
                        Services Completed
                    </strong>

                    <p>
                        Website, software, mobile app and
                        cybersecurity service pages completed.
                    </p>

                    <small>
                        August 20, 2026
                    </small>

                </div>

            </div>


            <div class="card files">

                <h3>
                    📁 Project Files
                </h3>

                <p>
                    Files shared with you by Omo Rabi Software.
                </p>

                <button onclick="showMessage('Website preview will open here.')">
                    View Website Preview
                </button>

                <button onclick="showMessage('Project design will be available here.')">
                    View Design
                </button>

                <button onclick="showMessage('Project report will be available here.')">
                    View Project Report
                </button>

            </div>


            <div class="card message-box">

                <h3>
                    💬 Send a Message
                </h3>

                <p>
                    Have a question or want to request a change?
                </p>

                <br>

                <textarea
                    id="clientMessage"
                    placeholder="Write your message here...">
                </textarea>

                <button
                    class="action-btn"
                    onclick="sendMessage()">
                    Send Message
                </button>

            </div>

        </section>


        <section class="card approval">

            <h3>
                ✅ Client Approval
            </h3>

            <p>
                When you are satisfied with the current
                project milestone, you can approve it.
            </p>

            <button onclick="approveProject()">
                Approve Current Milestone
            </button>

        </section>

    </main>


    <footer>

        <p>
            © 2026 Omo Rabi Software.
            Client Portal.
        </p>

    </footer>


    <script>

        function showMessage(message) {

            alert(message);

        }


        function sendMessage() {

            const message =
                document.getElementById("clientMessage").value.trim();


            if (message === "") {

                alert("Please write a message first.");

                return;

            }


            alert(
                "Message recorded successfully in this prototype."
            );


            document.getElementById("clientMessage").value = "";

        }


        function approveProject() {

            const approved =
                confirm(
                    "Are you sure you want to approve this milestone?"
                );


            if (approved) {

                alert(
                    "Thank you. Your approval has been recorded in this prototype."
                );

            }

        }

    </script>

</body>
</html>